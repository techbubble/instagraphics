{
  "manifest_version": 3,
  "name": "Instagraphic",
  "short_name": "Instagraphic",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Type your text, get an animated diagram in your brand colors. 229 layouts; download SVG, PNG, or GIF.",
  "action": {
    "default_title": "Open Instagraphic",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["__BASE__/*"]
}
